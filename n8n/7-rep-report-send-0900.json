{
  "name": "AIM · 9:00 AM rep report automatic send",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "reps-schedule",
      "name": "Weekdays 9:00 AM (New York time)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aim-crm-backend.onrender.com/api/cron/sales-rep-daily-report-send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000
        }
      },
      "id": "reps-http",
      "name": "Run automatic rep report send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "AIM CRM cron secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    }
  ],
  "connections": {
    "Weekdays 9:00 AM (New York time)": {
      "main": [
        [
          {
            "node": "Run automatic rep report send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/New_York",
    "executionOrder": "v1"
  },
  "active": false
}
