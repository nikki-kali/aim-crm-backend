# ============================================================
# AIM DENTAL CRM v3.0 — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=4000
FRONTEND_URL=https://aim-crm-frontend.vercel.app

# Database — Supabase PostgreSQL (Session Pooler connection string)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_EXPIRY=24h

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Aim Dental CRM <noreply@aimdentallab.com>
ALERT_EMAIL=your-alert-email@gmail.com

# Lead Capture — API key for POST /api/leads/capture
# Used by server-to-server integrations (social webhooks via Zapier/Make)
LEAD_CAPTURE_API_KEY=aim-dental-2026-secret

# Web Leads — POST /api/web-leads (no API key; called from browser JS on the
# marketing website's Contact and Scanner Program forms).
# Contact form recipient; defaults to media@aimdentallab.com if unset (set
# "for now" per the client — may change).
CONTACT_FORM_EMAIL=media@aimdentallab.com
# Scanner Program form recipient; defaults to digital@aimdentallab.com if unset.
WEB_LEADS_EMAIL=digital@aimdentallab.com

# Implant Intake — POST /api/implant-intake ("Submit Case to AIM" on the
# Implant Case Intake Protocol page). Recipient for the completed
# questionnaire; defaults to digital@aimdentallab.com if unset.
IMPLANT_INTAKE_EMAIL=digital@aimdentallab.com

# Newsletter — POST /api/newsletter (website popup + footer/blog CTA).
# Notification recipient when someone new subscribes; defaults to
# media@aimdentallab.com if unset. Subscribers are stored in the
# newsletter_subscribers table regardless (see scripts/newsletter-migration.sql).
NEWSLETTER_NOTIFY_EMAIL=media@aimdentallab.com

# Newsletter — Brevo sync. Optional: if either is unset, the Brevo sync is
# skipped entirely and only the newsletter_subscribers table is written (no
# error). Brevo is the system of record for actual subscribe/unsubscribe
# state — get the API key from Brevo Settings -> SMTP & API -> API Keys, and
# the list ID from Contacts -> Lists (the "AIM Website Newsletter" list).
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_LIST_ID=123

# Outsourcing Lab — POST /api/cases/ship-to-outsourcing ("Send to Outsourcing
# Lab" on the Cases page's Ready to Ship view, Removable cases only). The
# case-detail spreadsheet email (case #, patient, product, tooth numbers,
# quantity, shade, required return date) goes to this recipient.
# Set to media@aimdentallab.com for now to preview the email internally
# before switching to the real outsourcing partner's address.
OUTSOURCING_LAB_NAME=Aim Dental Laboratory
OUTSOURCING_LAB_EMAIL=media@aimdentallab.com

# Content Studio media storage — src/config/supabaseStorage.js, used by
# routes/contentPosts.js's upload/delete-media routes and
# jobs/mediaCleanup.js's 30-day cleanup job. Same Supabase project this
# backend already talks to via DATABASE_URL (dxpwfsyqmxdvnojgetpr), just
# accessed through the Storage API this time instead of raw Postgres —
# get the URL and service_role key from Supabase Dashboard → Settings →
# API. Never expose the service role key to a client.
SUPABASE_URL=https://dxpwfsyqmxdvnojgetpr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Content Approvals bridge — routes/contentApprovals.js proxies Marketing
# OS's Content Studio approval requests to Team Pulse's Projects boards
# (a separate app, ~/Desktop/Aim Employee Pulse), so approvers only ever
# work in Team Pulse. TEAM_PULSE_API_URL is that app's base URL (its local
# dev server, or the deployed Vercel URL); TEAM_PULSE_API_KEY must exactly
# match Team Pulse's own MARKETING_OS_API_KEY env var — it's the shared
# secret Team Pulse checks on its /api/integrations/marketing-os/* routes.
TEAM_PULSE_API_URL=http://localhost:3000
TEAM_PULSE_API_KEY=

# Social Connections — real OAuth for Marketing OS's Content Studio
# "Account connections" Settings section (routes/socialConnections.js,
# scripts/v10-social-connections-migration.sql). Instagram/X/LinkedIn only
# for now — the three platforms with real developer apps as of this
# writing. BACKEND_PUBLIC_URL builds each platform's redirect_uri (must
# exactly match what's registered in that platform's own app settings);
# SOCIAL_OAUTH_STATE_SECRET signs the OAuth `state` param (CSRF
# protection, no server-side session store); SOCIAL_TOKEN_ENCRYPTION_KEY
# encrypts tokens at rest (generate with `openssl rand -base64 32`).
BACKEND_PUBLIC_URL=https://aim-crm-backend.onrender.com
SOCIAL_OAUTH_STATE_SECRET=replace-with-long-random-secret
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Meta app (Instagram, via Facebook Login for Business + Instagram Graph API)
META_APP_ID=
META_APP_SECRET=

# X (Twitter) API v2 — OAuth 2.0 with PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — posting as a Company Page (organization), not a personal profile
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# First Admin User — only used by scripts/seed-admin.js
ADMIN_EMAIL=admin@aimdentallab.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
